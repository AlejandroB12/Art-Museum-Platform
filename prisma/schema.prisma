generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario   Int            @id @default(autoincrement())
  Email        String         @unique @db.VarChar(45)
  Contrasena   String         @db.VarChar(45)  @map("Contraseña")
  Nombre       String?        @db.VarChar(45)
  Apellido     String?        @db.VarChar(45)
  Estatus      Int?           @db.TinyInt
  Rol          String         @db.VarChar(20)
  comprador    Comprador?
  administrador Administrador?
  membresias   Membresia[]
  codigos      CodigoSeguridad[]
  solicitudes  SolicitudPago[]
}

model Comprador {
  id_usuario         Int      @id
  Cedula             Int      @unique
  Telefono           String?  @db.VarChar(15)
  CodigoVerificacion Int?
  id_parroquia       Int?
  Calle              String?  @db.VarChar(100)
  PuedeAdquirir      Int?     @default(1) @db.TinyInt
  usuario            Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}

model Administrador {
  id_usuario Int     @id
  usuario    Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}

model Membresia {
  idMembresia  Int      @id @default(autoincrement())
  FechaPago    DateTime? @db.Date
  MontoPagado  Decimal?  @db.Decimal(10, 2)
  id_usuario   Int?
  usuario      Usuario?  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}

model CodigoSeguridad {
  idCodigoSeguridad Int      @id @default(autoincrement())
  Pregunta          String?  @db.VarChar(45)
  Respuesta         String?  @db.VarChar(45)
  id_usuario        Int?
  usuario           Usuario? @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}

model SolicitudPago {
  id_solicitud   Int      @id @default(autoincrement())
  id_usuario     Int?
  FechaSolicitud DateTime? @db.DateTime(0)
  Monto          Decimal?  @default(10) @db.Decimal(10, 2)
  Estatus        String?   @default("Pendiente") @db.VarChar(20)
  usuario        Usuario?  @relation(fields: [id_usuario], references: [id_usuario])
}


model Nacionalidad {
  id_Nacionalidad Int      @id @default(autoincrement())
  Descripcion     String   @db.VarChar(100)
  autores         Autor[]
}

model Genero {
  id_Genero Int    @id
  Nombre    String @db.VarChar(50)
}

model Autor {
  id_Autor        Int           @id
  Nombre          String        @db.VarChar(100)
  Apellido        String        @db.VarChar(100)
  Fecha_nacimiento DateTime?    @db.Date
  Fotografia      String?       @db.VarChar(255)
  Biografia       String?       @db.Text
  id_Nacionalidad Int?
  nacionalidad    Nacionalidad? @relation(fields: [id_Nacionalidad], references: [id_Nacionalidad])
}

model Obra {
  id_Obra        Int      @id
  Nombre         String   @db.VarChar(150)
  Fecha_creacion DateTime? @db.Date
  Precio         Decimal? @db.Decimal(15, 2)
}