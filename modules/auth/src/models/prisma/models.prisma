generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario  Int       @id @default(autoincrement())
  Email       String    @unique @db.VarChar(255)
  Contraseña  String    @db.VarChar(255)
  Nombre      String    @db.VarChar(255)
  Apellido    String    @db.VarChar(255)
  Estatus     Int       @default(0)
  Rol         String    @default("comprador") @db.VarChar(50)

  Comprador         Comprador?
  Membresia         Membresia[]
  CodigoSeguridad   CodigoSeguridad[]
  SolicitudPago     SolicitudPago[]

  @@map("Usuario")
}

model Comprador {
  id_usuario          Int       @id
  Cedula              Int
  Telefono            String?   @db.VarChar(15)
  CodigoVerificacion  Int?
  id_parroquia        Int?
  Calle               String?   @db.VarChar(100)
  PuedeAdquirir       Boolean   @default(true)

  usuario   Usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  parroquia Parroquia? @relation(fields: [id_parroquia], references: [id_parroquia])

  @@map("Comprador")
}

model Membresia {
  idMembresia  Int       @id @default(autoincrement())
  FechaPago    DateTime  @db.Date
  MontoPagado  Decimal   @db.Decimal(10, 2)
  id_usuario   Int

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("Membresia")
}

model CodigoSeguridad {
  id         Int    @id @default(autoincrement())
  Pregunta   String @db.VarChar(255)
  Respuesta  String @db.VarChar(255)
  id_usuario Int

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("CodigoSeguridad")
}

model SolicitudPago {
  id_solicitud     Int       @id @default(autoincrement())
  id_usuario       Int
  FechaSolicitud   DateTime  @default(now()) @db.DateTime
  Monto            Decimal   @default(10.00) @db.Decimal(10, 2)
  Estatus          String    @default("Pendiente") @db.VarChar(20)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("SolicitudPago")
}

model Estado {
  id_estado Int    @id @default(autoincrement())
  nombre    String @db.VarChar(255)

  municipios Municipio[]

  @@map("Estado")
}

model Municipio {
  id_municipio Int    @id @default(autoincrement())
  nombre       String @db.VarChar(255)
  id_estado    Int

  estado     Estado     @relation(fields: [id_estado], references: [id_estado], onDelete: Cascade)
  parroquias Parroquia[]

  @@map("Municipio")
}

model Parroquia {
  id_parroquia Int    @id @default(autoincrement())
  nombre       String @db.VarChar(255)
  id_municipio Int

  municipio   Municipio  @relation(fields: [id_municipio], references: [id_municipio], onDelete: Cascade)
  compradores Comprador[]

  @@map("Parroquia")
}
