generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_URL")
}

model Usuario {
  id_usuario Int       @id @default(autoincrement())
  email      String    @unique @db.VarChar(45)
  password   String    @db.VarChar(255)
  nombre     String?   @db.VarChar(45)
  apellido   String?   @db.VarChar(45)
  activo     Boolean?  @default(true)
  rol        String    @default("comprador") @db.VarChar(20)

  comprador        Comprador?
  administrador    Administrador?
  membresias       Membresia[]
  preguntasSeguridad PreguntaSeguridad[]
  solicitudesPago  SolicitudPago[]
  facturas         Factura[]       @relation("FacturaComprador")
  facturasAdmin    Factura[]       @relation("FacturaAdmin")
  reservas         Reserva[]

  @@map("usuario")
}

model Comprador {
  id_usuario          Int       @id
  cedula              Int       @unique
  telefono            String?   @db.VarChar(15)
  codigo_verificacion String?   @db.VarChar(6)
  id_estado           Int?
  id_municipio        Int?
  id_parroquia        Int?
  calle               String?   @db.VarChar(100)

  usuario   Usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  estado    Estado?    @relation(fields: [id_estado], references: [id_estado])
  municipio Municipio? @relation(fields: [id_municipio], references: [id_municipio])
  parroquia Parroquia? @relation(fields: [id_parroquia], references: [id_parroquia])

  @@map("comprador")
}

model Administrador {
  id_usuario Int    @id

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("admin")
}

model Membresia {
  id_membresia    Int       @id @default(autoincrement())
  id_usuario      Int
  fecha_inicio    DateTime  @db.Date
  fecha_expiracion DateTime  @db.Date
  monto_pagado    Decimal   @db.Decimal(20, 2)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("membresia")
}

model SolicitudPago {
  id_solicitud    Int       @id @default(autoincrement())
  id_usuario      Int?
  fecha_solicitud DateTime? @db.Timestamp(3)
  monto           Decimal   @default(10.00) @db.Decimal(20, 2)
  estatus         String    @default("Pendiente") @db.VarChar(20)

  @@map("solicitud_pago")
}

model PreguntaSeguridad {
  id_pregunta Int     @id @default(autoincrement())
  pregunta    String? @db.VarChar(45)
  respuesta   String? @db.VarChar(45)
  id_usuario  Int

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("pregunta_seguridad")
}

model Factura {
  id_factura           Int       @id @default(autoincrement())
  fecha_venta          DateTime? @db.Timestamp(3)
  monto_neto           Decimal   @db.Decimal(20, 2)
  iva                  Decimal   @db.Decimal(20, 2)
  total_pagado         Decimal   @db.Decimal(20, 2)
  ganancia_usd         Decimal   @db.Decimal(20, 2)
  porcentaje_comision  Decimal   @db.Decimal(5, 2)
  id_obra              String    @db.VarChar(24)
  id_comprador         Int
  id_admin             Int

  comprador Usuario  @relation("FacturaComprador", fields: [id_comprador], references: [id_usuario])
  admin     Usuario  @relation("FacturaAdmin", fields: [id_admin], references: [id_usuario])
  envios    Envio[]

  @@map("factura")
}

model Reserva {
  id_reserva    Int       @id @default(autoincrement())
  id_obra       String    @db.VarChar(24)
  id_usuario    Int
  fecha_reserva DateTime? @db.Timestamp(3)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@map("reserva")
}

model Envio {
  id_envio       Int       @id @default(autoincrement())
  monto_total    Decimal?  @db.Decimal(20, 2)
  estado_entrega String?   @db.VarChar(20)
  fecha_envio    DateTime? @db.Timestamp(3)
  id_factura     Int       @unique

  factura Factura @relation(fields: [id_factura], references: [id_factura])

  @@map("envio")
}

model Estado {
  id_estado  Int    @id @default(autoincrement())
  nombre     String @db.VarChar(100)

  municipios  Municipio[]
  compradores Comprador[]

  @@map("estado")
}

model Municipio {
  id_municipio Int    @id @default(autoincrement())
  nombre       String @db.VarChar(100)
  id_estado    Int

  estado     Estado      @relation(fields: [id_estado], references: [id_estado])
  parroquias Parroquia[]
  compradores Comprador[]

  @@map("municipio")
}

model Parroquia {
  id_parroquia Int    @id @default(autoincrement())
  nombre       String @db.VarChar(100)
  id_municipio Int

  municipio   Municipio   @relation(fields: [id_municipio], references: [id_municipio])
  compradores Comprador[]

  @@map("parroquia")
}

